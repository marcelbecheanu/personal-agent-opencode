{
  "$schema": "https://opencode.ai/config.json",

  "model": "deepseek/flash-economy",
  "default_agent": "build",

  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 8000
    },
    "buffer": "15%"
  },

  "providers": {
    "deepseek": {
      "models": {
        "flash-economy": {
          "name": "DeepSeek Flash Economy",
          "modelID": "deepseek-flash",
          "limit": {
            "context": 1000000,
            "output": 8192
          },
          "body": {
            "thinking": {
              "type": "disabled"
            }
          }
        },
        "pro-reasoning": {
          "name": "DeepSeek Pro Reasoning",
          "modelID": "deepseek-v4-pro",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "skill",
          "resource": "token-efficiency",
          "effect": "allow"
        }
      ]
    },
    "plan": {
      "permissions": [
        {
          "action": "skill",
          "resource": "token-efficiency",
          "effect": "allow"
        }
      ]
    }
  }
}
